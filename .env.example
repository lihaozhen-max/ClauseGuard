# ============================================================
# ClauseGuard 合同审批审查系统 — 环境变量模板
# 用法：复制为 .env 并填入真实值。.env 已被 .gitignore 忽略，禁止提交。
# 复制命令：Copy-Item .env.example .env
# ============================================================

# ── 应用 ──────────────────────────────────────────────
APP_ENV=dev
APP_HOST=127.0.0.1
APP_PORT=8000
APP_LOG_LEVEL=INFO

# ── MySQL（由 database/docker-compose.yml 启动）──────────
# 注意：这些值需与 docker-compose.yml 中 MySQL 的初始化参数保持一致
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=clauseguard
DB_PASSWORD=                                # ← 填写本地开发库密码
DB_NAME=clauseguard
# 仅 docker compose 使用的 MySQL root 密码（SPEC CF-04 未列，属补充项；应用不读取）
DB_ROOT_PASSWORD=                           # ← 填写容器 root 密码

# ── 模拟审批系统（独立服务）─────────────────────────────
APPROVAL_BASE_URL=http://127.0.0.1:8100
APPROVAL_API_KEY=                           # ← 模拟系统内部鉴权用，可自定
INTERNAL_API_KEY=                                    # ← 后端内部接口鉴权（前端调用时带 X-API-Key）

# ── 合同附件本地存储 ────────────────────────────────────
# 该目录不对外公开访问，仅后端读取（PRD 19.5）
STORAGE_DIR=./storage/contracts

# ── LLM（DeepSeek 官方 API，OpenAI 兼容）────────────────
# 仅在语义型规则（R003/R004/R010）与摘要生成时调用。
# 置为 false 或留空 Key 时自动降级为纯规则 + 模板摘要，不影响全闭环演示。
LLM_ENABLED=true
LLM_BASE_URL=https://api.deepseek.com
LLM_API_KEY=                                # ← 填写 DeepSeek API Key（sk- 开头）

# 该端点 GET /v1/models 实测返回的可用模型：deepseek-flash、deepseek-v4-pro
#   deepseek-flash   1.3s / 248 tokens : 快且便宜，已具备推理能力 —— 默认选它
#   deepseek-v4-pro  3.6s / 302 tokens : 更强，质量优先时切换
# 注：这两个都是推理模型，响应里额外带 reasoning_content 字段。
LLM_MODEL=deepseek-flash
LLM_TIMEOUT_SECONDS=60
# ⚠️ 推理 token 计入 max_tokens：实测 max_tokens=8 会返回空 content，必须留足
LLM_MAX_TOKENS=1024
# 风险判定要可复现，建议 0
LLM_TEMPERATURE=0

# 备选端点（同为 OpenAI 兼容，切换只需改上面三行）
# LLM_BASE_URL=https://cloud.hongqiye.com/v1
# LLM_MODEL=gpt-5.3

# ── OCR（PaddleOCR）───────────────────────────────────
# 模型缓存目录；首次运行会自动下载，交付包中不包含模型文件
# 单页可提取字符数低于该值即判定为扫描页，走 OCR
OCR_SCAN_PAGE_MIN_CHARS=20
OCR_LANG=ch
OCR_USE_GPU=false
# 留空 = 自动选择 ASCII 安全目录（%LOCALAPPDATA%\ClauseGuard\ocr_models）。
# ⚠️ 不要指向含中文的路径：Paddle Inference 在 Windows 上打不开非 ASCII 路径下的
#    模型文件，会报出误导性的 "json parse error"（详见 docs/M2-验收记录.md R-01）。
OCR_MODEL_DIR=
# SPEC §11 补充项：paddle 3.3.1 的 PIR 执行器在 oneDNN/MKLDNN 路径上存在转换缺陷
# （ConvertPirAttribute2RuntimeAttribute not support），必须保持 false。
OCR_ENABLE_MKLDNN=false

# ── 规则阈值默认值（可在 review_rules.match_params_json 中按规则覆盖）──
RULE_PREPAY_MAX_RATIO=0.30
RULE_PAYMENT_MAX_DAYS=90
